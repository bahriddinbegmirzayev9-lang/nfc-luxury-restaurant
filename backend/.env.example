# Environment Configuration
# NFC Luxury Restaurant Backend

# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nfc_luxury_restaurant
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Socket.IO
SOCKET_PORT=5001

# NFC Configuration
NFC_TAG_PREFIX=nfc://table/
NFC_ENCRYPTION_KEY=your-nfc-encryption-key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Tax & Service
TAX_RATE=0.15
SERVICE_CHARGE_RATE=0.10

# Payment
PAYMENT_TIMEOUT=300000

# Session
SESSION_TIMEOUT=14400000
